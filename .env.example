# Never commit a real key. Use a long random value (at least 24 characters).
CONTROL_API_KEY=replace-with-a-random-secret-at-least-24-characters
# Private, self-hosted 3DAIGC-API deployment; default localhost from gateway process.
UPSTREAM_BASE_URL=http://127.0.0.1:7842
# Enable authentication in the upstream service when deployed; never expose anonymous upstream jobs publicly.
UPSTREAM_BEARER_TOKEN=
