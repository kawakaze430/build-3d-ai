# Never commit a real key. Use a long random value (at least 24 characters).
CONTROL_API_KEY=replace-with-a-random-secret-at-least-24-characters
# Private, self-hosted 3DAIGC-API deployment; default localhost from gateway process.
UPSTREAM_BASE_URL=http://127.0.0.1:7842
# Enable authentication in the upstream service when deployed; never expose anonymous upstream jobs publicly.
UPSTREAM_BEARER_TOKEN=

# Optional read-only JSON with fully reviewed model approvals; default disables generation.
# MODEL_APPROVAL_FILE=/etc/build3d/model-approvals.json

# Product API (apps/api): tenant API keys are provisioned with build3d-admin.
# These are separate from CONTROL_API_KEY and never inherit its privileges.
DATABASE_URL=sqlite:///./data/build3d.db
ARTIFACT_DIR=./data/artifacts
MAX_ACTIVE_JOBS_PER_USER=3
API_REQUESTS_PER_MINUTE=120
# Compose only: use a long random URL-safe value, not this placeholder.
POSTGRES_PASSWORD=replace-with-a-private-url-safe-password
